# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://mytuums:mytuums_dev@localhost:5432/mytuums"

# ── BetterAuth ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET="replace-with-a-secure-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:5173"
DOCS_APP_URL="http://localhost:5174"

# ── Resend (transactional email) ─────────────────────────────────────
# RESEND_API_KEY="re_..."
SUPPORT_EMAIL="support@mytuums.com"
PRIVACY_EMAIL="privacy@mytuums.com"

# ── Azure Storage (Azurite locally; Azure Blob in production) ────────
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
# AZURE_STORAGE_ACCOUNT_NAME="..."
# AZURE_STORAGE_ACCOUNT_KEY="..."

# ── Media ────────────────────────────────────────────────────────────
MEDIA_CONTAINER_NAME="user-media"
GAME_COVERS_CONTAINER_NAME="game-covers"

# ── Sentry (error monitoring) ────────────────────────────────────────
# SENTRY_DSN="https://..."
# SENTRY_RELEASE="local"
# VITE_SENTRY_DSN="https://..."
# VITE_SENTRY_RELEASE="local"

# ── Launch gates ─────────────────────────────────────────────────────
# With NODE_ENV=development, the API skips launch-readiness checks and treats
# signup/media as enabled regardless of the two flags below (production still enforces both).
PUBLIC_SIGNUP_ENABLED="false"
MEDIA_UPLOADS_ENABLED="false"
VITE_PUBLIC_SIGNUP_ENABLED="false"

# ── Bootstrap ────────────────────────────────────────────────────────
# OWNER_BOOTSTRAP_SECRET="..."

# ── Node ─────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── API ──────────────────────────────────────────────────────────────
API_PORT=4000
