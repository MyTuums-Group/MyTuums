# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://mytuums:mytuums_dev@localhost:5432/mytuums"

# ── BetterAuth ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET="replace-with-a-secure-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:5173"
DOCS_APP_URL="http://localhost:5174"

# ── Resend (transactional email) ─────────────────────────────────────
# RESEND_API_KEY="re_..."

# ── Azure Storage (production only) ──────────────────────────────────
# AZURE_STORAGE_CONNECTION_STRING="..."
# AZURE_STORAGE_ACCOUNT_NAME="..."
# AZURE_STORAGE_ACCOUNT_KEY="..."

# ── Media ────────────────────────────────────────────────────────────
MEDIA_CONTAINER_NAME="user-media"
GAME_COVERS_CONTAINER_NAME="game-covers"

# ── Sentry (error monitoring) ────────────────────────────────────────
# SENTRY_DSN="https://..."

# ── Bootstrap ────────────────────────────────────────────────────────
# OWNER_BOOTSTRAP_SECRET="..."

# ── Node ─────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── API ──────────────────────────────────────────────────────────────
API_PORT=4000
